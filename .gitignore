# Datos de prospectos y clientes. La cola lleva nombres y emails, y las
# auditorías llevan el análisis de tiendas que no son tuyas: nada de esto
# entra en un repositorio, y menos si algún día lo haces público para
# aprovechar los minutos ilimitados de Actions.
audit-engine/queue.csv
audit-engine/auditorias/
audit-engine/informes/
audit-engine/analisis/

# Claves
.env
.env.*
!.env.example

# Salida del build: se genera con `node build.js`, no se versiona.
# En Cloudflare Pages: build command `node build.js`, output directory `dist`.
dist/

# macOS
.DS_Store
